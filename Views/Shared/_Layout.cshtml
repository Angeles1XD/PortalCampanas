<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PortalCampanas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>

<header>
    <nav class="navbar navbar-light bg-light px-3">
        <a class="navbar-brand">PortalCampanas</a>

        <div>
            <a asp-controller="Campanas" asp-action="Index" class="btn btn-light">Listado</a>
            <a asp-controller="Campanas" asp-action="Filtro" class="btn btn-warning">Filtrar</a>
            <a asp-controller="Campanas" asp-action="Resumen" class="btn btn-light">Resumen</a>
        </div>
    </nav>
</header>

<div class="container mt-4">
    @RenderBody()
</div>

</body>
</html>